# --- Whoop (developer.whoop.com -> Create App) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/callback
# Optional: secret used to verify incoming Whoop webhooks
WHOOP_WEBHOOK_SECRET=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
# Filled automatically on /start, or set manually
TELEGRAM_CHAT_ID=

# --- Claude (structured extraction of the voice diary) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (voice transcription only) ---
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Local ---
DB_URL=sqlite:///data/whoop.db
TZ_NAME=Asia/Almaty
DIGEST_HOUR=8
DIGEST_MINUTE=0
SYNC_INTERVAL_MINUTES=30
API_HOST=127.0.0.1
API_PORT=8000

# --- iPhone widget (optional) ---
# github.com/settings/tokens -> classic token with only the "gist" scope,
# then: python cli.py widget setup
WIDGET_GITHUB_TOKEN=
# Filled automatically by setup; set only to reuse an existing gist
WIDGET_GIST_ID=
